# Australian Payroll Association CRM — environment variables
# Copy to .env.local and fill in real values. .env.local is git-ignored.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase database password (used by the migration script only)
SUPERBASE_PASSWORD=

# App — your live domain (used for links/redirects)
NEXT_PUBLIC_SITE_URL=https://apa-crm-natali.vercel.app

# Resend — resend.com → API Keys (Build 2: confirmation + notification emails)
RESEND_API_KEY=
# Verified sender identity (must match a verified Resend domain)
EMAIL_FROM="Australian Payroll Association <noreply@send.apa.com.au>"
# Where new-lead notifications are sent (the operator's inbox)
ADMIN_NOTIFY_EMAIL=natali@austpayroll.com.au
